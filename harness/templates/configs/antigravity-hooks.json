{
  "amh-session-start": {
    "SessionStart": [
      {
        "type": "command",
        "command": "root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0; exec bash \"$root/scripts/session-start.sh\" --json=inject-steps",
        "timeout": 30
      }
    ]
  },
  "amh-command-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0; exec bash \"$root/scripts/command-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
